{
  "name": "muse-number-two-desktop",
  "version": "1.0.0",
  "description": "Unofficial Muse desktop launcher",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fedpromptly.musenumbertwo.desktop",
    "productName": "Muse Number Two",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Muse-Number-Two-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
